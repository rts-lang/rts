
##
  lib.print(str.pointer, str.length) — Ручная распаковка полей.
  lib.print(str) — Целиком, chillffi сам раскладывает String на ptr+len за счет chillffi.
##

printc(str: String) {
  lib: Pointer = importNative("./libprint.so")
  lib.print(str.pointer, str.length)
  lib.print(str)
}

printc("Hello from RTS 222!")
