
###
  Это ручное приведение чисел явным типом: `a: U8 = 300`.
  Значение зажимается в границы типа - константное поведение (#71).

  Токены языка бесконечны, поэтому это работает и для чисел, которые больше
  любого ABI типа: они сначала становятся границей u64 или i64, а потом
  зажимаются в границы нужного типа.
###

a: U8 = 300
print(f"{type(a)} | {stype(a)} = {a}\n")   # UInt | U8 = 255
b: U8 = -10
print(f"{type(b)} | {stype(b)} = {b}\n")   # Int | U8 = 0
c: I8 = -300
print(f"{type(c)} | {stype(c)} = {c}\n")   # Int | I8 = -128
d: U64 = 18446744073709551616
print(f"{type(d)} | {stype(d)} = {d}\n")   # UInt | U64 = 18446744073709551615
e: Usize = 18446744073709551616
print(f"{type(e)} | {stype(e)} = {e}\n")   # UInt | Usize = 18446744073709551615
f: Isize = -9223372036854775809
print(f"{type(f)} | {stype(f)} = {f}\n")   # Int | Isize = -9223372036854775808
#
println("=====")

g: U8 = 44444444444444444444444444444444444444444444
print(f"{type(g)} | {stype(g)} = {g}\n")   # UInt | U8 = 255
h: I8 = 44444444444444444444444444444444444444444444
print(f"{type(h)} | {stype(h)} = {h}\n")   # UInt | I8 = 127
i: I64 = -44444444444444444444444444444444444444444444
print(f"{type(i)} | {stype(i)} = {i}\n")   # Int | I64 = -9223372036854775808
j: Usize = 44444444444444444444444444444444444444444444
print(f"{type(j)} | {stype(j)} = {j}\n")   # UInt | Usize = 18446744073709551615
k: Isize = -44444444444444444444444444444444444444444444
print(f"{type(k)} | {stype(k)} = {k}\n")   # Int | Isize = -9223372036854775808
#
println("=====")

l: F32 = 44444444444444444444444444444444444444444444
print(f"{type(l)} | {stype(l)} = {l}\n")   # UInt | F32 = 340282350000000000000000000000000000000
m: F32 = -1.7976931348623157e309
print(f"{type(m)} | {stype(m)} = {m}\n")   # Float | F32 = -340282350000000000000000000000000000000
n: U8 = 1.7976931348623157e309
print(f"{type(n)} | {stype(n)} = {n}\n")   # UFloat | U8 = 255
