###
  Синтаксис float-литералов (issue #31): 0.0 = .0 = . = 0
###

# ======================================================================================================================

a~~ = 0 # Полная mut для кода ниже.

# ======================================================================================================================

# Голая точка и нули
a = .
print(f"{a} | {type(a)}\n")  # 0 | UFloat

a = .0
print(f"{a} | {type(a)}\n")  # 0 | UFloat

a = 0.
print(f"{a} | {type(a)}\n")  # 0 | UFloat

a = 0.0
print(f"{a} | {type(a)}\n")  # 0 | UFloat

# ======================================================================================================================
println("=====")

# Leading dot
a = .1
print(f"{a} | {type(a)}\n")  # 0.1 | UFloat

a = .5
print(f"{a} | {type(a)}\n")  # 0.5 | UFloat

a = .25
print(f"{a} | {type(a)}\n")  # 0.25 | UFloat

# ======================================================================================================================
println("=====")

# Trailing dot
a = 3.
print(f"{a} | {type(a)}\n")  # 3. | UFloat

a = 201.
print(f"{a} | {type(a)}\n")  # 201. | UFloat

# ======================================================================================================================
println("=====")

# Выражения (+ - /)
a = .5 + .5
print(f"{a} | {type(a)}\n")  # 1 | UFloat

a = 1. + .5
print(f"{a} | {type(a)}\n")  # 1.5 | UFloat

a = 3. + 2.
print(f"{a} | {type(a)}\n")  # 5 | UFloat

a = .5 - .25
print(f"{a} | {type(a)}\n")  # 0.25 | UFloat

a = 10.5 - 10.0
print(f"{a} | {type(a)}\n")  # 0.5 | UFloat

a = . + .5
print(f"{a} | {type(a)}\n")  # 0.5 | UFloat

a = 1 / .5
print(f"{a} | {type(a)}\n")  # 2 | UFloat

# ======================================================================================================================
