
# Контроль: обычное деление (делитель не 0).

a~~ = 0 # Полная mut для кода ниже

# Целые
a = 10 / 4
print(f"{a} | {type(a)}\n")  # 2 | UInt

a = 10 / 5
print(f"{a} | {type(a)}\n")  # 2 | UInt

a = -7 / 2
print(f"{a} | {type(a)}\n")  # -3 | Int

a = 7 / -2
print(f"{a} | {type(a)}\n")  # -3 | Int

a = -7 / -2
print(f"{a} | {type(a)}\n")  # 3 | Int

#
println("=====")

# Дробные
a = 10 / 4.0
print(f"{a} | {type(a)}\n")  # 2.5 | UFloat

a = 10 / 0.5
print(f"{a} | {type(a)}\n")  # 20 | UFloat

a = 1 / 0.1
print(f"{a} | {type(a)}\n")  # 10 | UFloat

a = -7.5 / 2
print(f"{a} | {type(a)}\n")  # -3.75 | Float

#
println("=====")

# Цепочки и приоритет
a = 100 / 10 / 2
print(f"{a} | {type(a)}\n")  # 5 | UInt

a = 10 - 6 / 2
print(f"{a} | {type(a)}\n")  # 7 | UInt

a = 10 + 6 / 2
print(f"{a} | {type(a)}\n")  # 13 | UInt

a = 20 - 8 / 4 - 1
print(f"{a} | {type(a)}\n")  # 17 | UInt

# Минус слитно с числом (`-6` - одно число): `10 -6 / 2` = `10 + (-6 / 2)`
a = 10 -6 / 2
print(f"{a} | {type(a)}\n")  # 7 | UInt
