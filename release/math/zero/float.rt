
##
  Деление на 0 не ошибка: результат - левая часть выражения (issue #30).
  Дробные числа UFloat и Float; литералы и переменные.
##

# ======================================================================================================================

a~~ = 0 # Полная mut для кода ниже

# ======================================================================================================================

# UFloat / UFloat
a = 10.5 / 0.0
print(f"{a} | {type(a)}\n")   # 10.5 | UFloat

a = 0.0 / 0.0
print(f"{a} | {type(a)}\n")   # 0 | UFloat

# Float / UFloat
a = -10.5 / 0.0
print(f"{a} | {type(a)}\n")   # -10.5 | Float

# UFloat / Float (отрицательный ноль тоже ноль);
# при UFloat в операндах тип идет по знаку результата
a = 10.5 / -0.0
print(f"{a} | {type(a)}\n")   # 10.5 | UFloat

# Float / Float
a = -10.5 / -0.0
print(f"{a} | {type(a)}\n")   # -10.5 | Float

# ======================================================================================================================
println("=====")

# Переменные
x = 10.5
n = -10.5
z = 0.0

a = x / z
print(f"{a} | {type(a)}\n")   # 10.5 | UFloat

a = x / 0.0
print(f"{a} | {type(a)}\n")   # 10.5 | UFloat

a = n / z
print(f"{a} | {type(a)}\n")   # -10.5 | Float

# ======================================================================================================================
