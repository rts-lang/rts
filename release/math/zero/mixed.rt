
##
  Деление на 0 не ошибка: результат - левая часть выражения (issue #30).
  Смешанные целые и дробные числа; тип результата определяют типы операндов.
##

# ======================================================================================================================

a~~ = 0 # Полная mut для кода ниже.

# ======================================================================================================================
# Целое / дробный ноль.
println("")

a = 10 / 0.0
print(f"{a} | {type(a)}\n")  # 10 | UFloat

a = 0 / 0.0
print(f"{a} | {type(a)}\n")  # 0 | UFloat

a = -10 / 0.0
print(f"{a} | {type(a)}\n")  # -10 | Float

a = 10 / -0.0
print(f"{a} | {type(a)}\n")  # 10 | Float

a = -10 / -0.0
print(f"{a} | {type(a)}\n")  # -10 | Float

# ======================================================================================================================
# Дробное / целый ноль.
println("")

a = 10.5 / 0
print(f"{a} | {type(a)}\n")  # 10.5 | UFloat

a = -10.5 / 0
print(f"{a} | {type(a)}\n")  # -10.5 | Float

a = 10.5 / -0
print(f"{a} | {type(a)}\n")  # 10.5 | UFloat

a = -10.5 / -0
print(f"{a} | {type(a)}\n")  # -10.5 | Float

# ======================================================================================================================
