
# TokenType::UInt бесконечен - это тип токена, а не Value::UInt(u64).
# Ограничение по размеру накладывается структурой (stype, ABI), не calculate.
# Поэтому type() большого числа всегда UInt, даже когда Value::UInt переполнен.
# До фикса calculate.rs возвращал None для чисел > u64::MAX.

a~~ = 0 # Полная mut для кода ниже

# u64::MAX: помещается в Value::UInt, stype = U64
a = 18446744073709551615
print(f"{a} | {type(a)} | {stype(a)}\n")   # 18446744073709551615 | UInt | U64

# u64::MAX + 1: литераль > u64::MAX, type = UInt (не None!), stype = None
a = 18446744073709551616
print(f"{a} | {type(a)} | {stype(a)}\n")   #  | UInt | None

# Очень большой литераль: type = UInt (не None!), stype = None
a = 99999999999999999999999
print(f"{a} | {type(a)} | {stype(a)}\n")   #  | UInt | None

#
println("=====")

# Операции: тип результата UInt, даже когда Value::UInt переполнен.
# Значение Value::UInt становится 0 из-за неудачного парсинга в u64,
# но тип токена остаётся UInt (это и проверяет фикс calculate.rs).

# u64::MAX / 0: деление на 0 (issue #30), type = UInt
a = 18446744073709551615 / 0
print(f"{a} | {type(a)} | {stype(a)}\n")   # 18446744073709551615 | UInt | U64

# u64::MAX / 1: обычное деление, type = UInt
a = 18446744073709551615 / 1
print(f"{a} | {type(a)} | {stype(a)}\n")   # 18446744073709551615 | UInt | U64

# Большой UInt / 0: type = UInt (не None!), value = 0
a = 99999999999999999999999 / 0
print(f"{a} | {type(a)} | {stype(a)}\n")   # 0 | UInt | U8

# Большой UInt / 1: type = UInt (не None!), value = 0
a = 99999999999999999999999 / 1
print(f"{a} | {type(a)} | {stype(a)}\n")   # 0 | UInt | U8

#
println("=====")

# i64::MIN: помещается в Value::Int, stype = I64
a = -9223372036854775808
print(f"{a} | {type(a)} | {stype(a)}\n")   # -9223372036854775808 | Int | I64

# i64::MIN - 1: литераль < i64::MIN, type = Int (не None!), stype = None
a = -9223372036854775809
print(f"{a} | {type(a)} | {stype(a)}\n")   #  | Int | None

# i64::MIN / 0: деление на 0 (issue #30), type = Int
a = -9223372036854775808 / 0
print(f"{a} | {type(a)} | {stype(a)}\n")   # -9223372036854775808 | Int | I64
