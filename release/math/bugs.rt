
##
  Известные баги вычитания и скобок (проверено: одинаково на 12536e0 и с фиксом деления #30).
  Справа ожидаемое значение; строкой выше - что печатается сейчас.
##

# Скобки: результат выражения в скобках
# сейчас: (пусто)
println((10-20))  # -10

# сейчас: (пусто)
println((10 - 20))  # -10

# сейчас: 0
println((1+2)-(3+4))  # -4

# сейчас: 0
println(10 - (20 - 5))  # -5

# сейчас: 10
println(10 + (-20))  # -10

# сейчас: 10
println(10+(-20))  # -10

# сейчас: (пусто)
println(-(5))  # -5

# сейчас: (пусто)
println(-(2 + 3) - 4)  # -9

#
println("=====")

# Двойной минус и унарный минус с пробелом
# сейчас: 5
println(5 - -5)  # 10

# сейчас: -5
println(-5 - -5)  # 0

# сейчас: 1
println(1 - - 5)  # 6

#
println("=====")

# Переменные: x = 10, y = 20
x = 10
y = 20

# сейчас: 0
println(x-y)  # -10

# сейчас: 0
println(x - y)  # -10

# сейчас: 10
println(x + -y)  # -10

# сейчас: -5
println(x - y - 5)  # -15
