###
  Union: `a: U8 | String` (issue #59)

  Это НЕ аналог TypeScript. Объединение здесь - это список ДОПУСТИМЫХ типов,
  а в структуре единовременно лежит РОВНО ОДИН из них.

  Правила подбора варианта при присваивании:
  1. если значение уже помещается в один из вариантов как есть - берётся он;
  2. иначе значение приводится в первый вариант, в который приведение возможно
     (с зажимом в границы типа - константное поведение #71);
  3. иначе присваивается None (#71: неожиданное поведение - это None).

  Вариантом может быть и примитив: `a: 10 | 20`, `a: "text" | U8` - тогда это
  значение, допустимое только при точном совпадении (см. конец файла).

  Отдельно про мутабельность (issue #22): при `~~` тип и так меняется свободно,
  поэтому объединение можно указать, но оно ничего не ограничивает.
###

# ======================================================================================================================
println("")

# Объединение без мутабельности: тип зафиксирован, но внутри лежит один вариант.

a: U8 | String = 10
print(f"{a} | {type(a)} | {stype(a)}\n")  # 10 | UInt | U8

# Строковый вариант: значение не приводится, а ложится как есть
b: U8 | String = "hello"
print(f"{b} | {type(b)} | {stype(b)}\n")  # hello | String | String

# Приведения нет ни к одному варианту - None
c: U8 | String = True
print(f"{c} | {type(c)} | {stype(c)}\n")  #  | None | None

# Явный `| None` - это законный вариант объединения
d: String | None = "text"
print(f"{d} | {type(d)} | {stype(d)}\n")  # text | String | String

# ======================================================================================================================
println("")

# Значение помещается в один из вариантов без потерь - берётся именно он,
# а не первый в списке: -10 помещается в I8, поэтому не зажимается в U8 нулём.
e: U8 | I8 = -10
print(f"{e} | {type(e)} | {stype(e)}\n")  # -10 | Int | I8

# Float, объявленный отдельным вариантом, остаётся Float
f: U8 | F32 = 1.5
print(f"{f} | {type(f)} | {stype(f)}\n")  # 1.5 | UFloat | F32

# ======================================================================================================================
println("")

# Точного совпадения нет - приводим в первый подходящий вариант,
# с зажимом в границы типа (#71), ровно как при `x: U8 = 300`
g: U8 | String = 300
print(f"{g} | {type(g)} | {stype(g)}\n")  # 255 | UInt | U8

h: I8 | U8 | F64 | None = -300
print(f"{h} | {type(h)} | {stype(h)}\n")  # -128 | Int | I8

# ======================================================================================================================
println("")

# Переменная (модификатор `~`): значение меняется, набор вариантов остаётся.
# Каждое присваивание снова подбирает свой вариант.

i~: U8 | String = 10
print(f"{i} | {type(i)} | {stype(i)}\n")  # 10 | UInt | U8

i = "text"
print(f"{i} | {type(i)} | {stype(i)}\n")  # text | String | String

i = 300
print(f"{i} | {type(i)} | {stype(i)}\n")  # 255 | UInt | U8

i = True
print(f"{i} | {type(i)} | {stype(i)}\n")  #  | None | None

# ======================================================================================================================
println("")

# `~~` (Dynamic): тип меняется свободно, поэтому объединение
# можно указать, но оно ничего не ограничивает (issue #22).

j~~: U8 | String = 10
print(f"{j} | {type(j)} | {stype(j)}\n")  # 10 | UInt | U8

j = 1.5
print(f"{j} | {type(j)} | {stype(j)}\n")  # 1.5 | UFloat | F32

j = 99999
print(f"{j} | {type(j)} | {stype(j)}\n")  # 99999 | UInt | U32

# ======================================================================================================================
println("")

# Примитивы как варианты типизации (type-секция слева от `=`).
#
# Примитив можно указать как границу типа: `a: 10 | 20`, `a: "text" | U8`.
# Допустимо только ТОЧНОЕ совпадение значения: без приведения и без зажима.
# Не подошло - None (#71); писать `| None` для этого не нужно, он скрытый вариант.
#
# stype  = выбранный вариант (примитив `10` / `"text"` или тип `U8` / `String`)
# utype  = полный union как в объявлении (`10 | 20`, `String | 10`)
# type   = тип токена-значения (UInt, String, ...)
#
# Справа от `=` символ `|` - это не типизация, а логическое ИЛИ: `x = 10 | 20`.

l: 10 | 20 = 10
print(f"{l} | {type(l)} | {stype(l)} | {utype(l)}\n")  # 10 | UInt | 10 | 10 | 20

m: 10 | 20 = 15
print(f"{m} | {type(m)} | {stype(m)}\n")  #  | None | None

n: 10 | 20 = "text"
print(f"{n} | {type(n)} | {stype(n)}\n")  #  | None | None

o: 10 | 20 = None
print(f"{o} | {type(o)} | {stype(o)}\n")  #  | None | None

# Смешанный набор: строка и число
p: "text" | 10 = "text"
print(f"{p} | {type(p)} | {stype(p)} | {utype(p)}\n")  # text | String | "text" | "text" | 10

q: "text" | 10 = True
print(f"{q} | {type(q)} | {stype(q)}\n")  #  | None | None

# Примитив рядом с типом: сначала точный примитив, потом тип, потом приведение
r: U8 | 10 = 300
print(f"{r} | {type(r)} | {stype(r)} | {utype(r)}\n")  # 255 | UInt | U8 | U8 | 10

r2: U8 | 10 = 10
print(f"{r2} | {type(r2)} | {stype(r2)}\n")  # 10 | UInt | 10

# Тип + примитив
u: String | 10 = 10
print(f"{u} | {type(u)} | {stype(u)} | {utype(u)}\n")  # 10 | UInt | 10 | String | 10

v~: String | "text" = "text"
print(f"{v} | {type(v)} | {stype(v)} | {utype(v)}\n")  # text | String | "text" | String | "text"

v = "other"
print(f"{v} | {type(v)} | {stype(v)} | {utype(v)}\n")  # other | String | String | String | "text"

# Одиночный примитив
s: 10 = 11
print(f"{s} | {type(s)} | {stype(s)}\n")  #  | None | None

# `~`: набор примитивов остаётся и ограничивает каждое присваивание
t~: 10 | 20 = 10
t = 20
print(f"{t} | {type(t)} | {stype(t)} | {utype(t)}\n")  # 20 | UInt | 20 | 10 | 20

t = 30
print(f"{t} | {type(t)} | {stype(t)}\n")  #  | None | None

t = 10
print(f"{t} | {type(t)} | {stype(t)}\n")  # 10 | UInt | 10

# ======================================================================================================================
