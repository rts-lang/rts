###
  Union: `a: U8 | String` (issue #59)

  Это НЕ аналог TypeScript. Объединение здесь - это список ДОПУСТИМЫХ типов,
  а в структуре единовременно лежит РОВНО ОДИН из них.

  Правила подбора варианта при присваивании:
  1. если значение уже помещается в один из вариантов как есть - берётся он;
  2. иначе значение приводится в первый вариант, в который приведение возможно
     (с зажимом в границы типа - константное поведение #71);
  3. иначе присваивается None (#71: неожиданное поведение - это None).

  Отдельно про мутабельность (issue #22): при `~~` тип и так меняется свободно,
  поэтому объединение можно указать, но оно ничего не ограничивает.
###

# ======================================================================================================================

# Объединение без мутабельности: тип зафиксирован, но внутри лежит один вариант

a: U8 | String = 10
print(f"{a} | {type(a)} | {stype(a)}\n")  # 10 | UInt | U8

# Строковый вариант: значение не приводится, а ложится как есть
b: U8 | String = "hello"
print(f"{b} | {type(b)} | {stype(b)}\n")  # hello | String | String

# Приведения нет ни к одному варианту - None
c: U8 | String = True
print(f"{c} | {type(c)} | {stype(c)}\n")  #  | None | None

# Явный `| None` - это законный вариант объединения
d: String | None = "text"
print(f"{d} | {type(d)} | {stype(d)}\n")  # text | String | String

# ======================================================================================================================
println("=====")

# Значение помещается в один из вариантов без потерь - берётся именно он,
# а не первый в списке: -10 помещается в I8, поэтому не зажимается в U8 нулём
e: U8 | I8 = -10
print(f"{e} | {type(e)} | {stype(e)}\n")  # -10 | Int | I8

# Float, объявленный отдельным вариантом, остаётся Float
f: U8 | F32 = 1.5
print(f"{f} | {type(f)} | {stype(f)}\n")  # 1.5 | UFloat | F32

# ======================================================================================================================
println("=====")

# Точного совпадения нет - приводим в первый подходящий вариант,
# с зажимом в границы типа (#71), ровно как при `x: U8 = 300`
g: U8 | String = 300
print(f"{g} | {type(g)} | {stype(g)}\n")  # 255 | UInt | U8

h: I8 | U8 | F64 | None = -300
print(f"{h} | {type(h)} | {stype(h)}\n")  # -128 | Int | I8

# ======================================================================================================================
println("=====")

# `~` (Variable): значение меняется, набор вариантов остаётся.
# Каждое присваивание снова подбирает свой вариант.

i~: U8 | String = 10
print(f"{i} | {type(i)} | {stype(i)}\n")  # 10 | UInt | U8

i = "text"
print(f"{i} | {type(i)} | {stype(i)}\n")  # text | String | String

i = 300
print(f"{i} | {type(i)} | {stype(i)}\n")  # 255 | UInt | U8

i = True
print(f"{i} | {type(i)} | {stype(i)}\n")  #  | None | None

# ======================================================================================================================
println("=====")

# `~~` (Dynamic): тип меняется свободно, поэтому объединение
# можно указать, но оно ничего не ограничивает (issue #22)

j~~: U8 | String = 10
print(f"{j} | {type(j)} | {stype(j)}\n")  # 10 | UInt | U8

j = 1.5
print(f"{j} | {type(j)} | {stype(j)}\n")  # 1.5 | UFloat | F32

j = 99999
print(f"{j} | {type(j)} | {stype(j)}\n")  # 99999 | UInt | U32

# ======================================================================================================================
println("=====")

# Литералы и выражения - это НЕ типы, объединение из них не собирается:
# `x: 1 | 2` и `x: "name" | 10` не поддерживаются (issue #59).
# Обычный одиночный тип при этом не ломается и ведёт себя как раньше.

k: U8 = 300
print(f"{k} | {type(k)} | {stype(k)}\n")  # 255 | UInt | U8

# ======================================================================================================================
