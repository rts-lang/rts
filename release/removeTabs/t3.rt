
# Блок с результатом

a = {
  b = 10+10
  = b
}

# Переносы и общие строки

test()
test2()

# Одна строка т.к. написано на 1 строке
test() test2()

# Числа и слова сливаются

ab cd

12 34 56 A b c

12 34 e + 2 A b c

12 34  .  20  e  +  2 A b c

# ++ слит, b это вторая строка
a+ +
b

# Минус должен быть слит с числом
-100
- 100

# Должен был быть: `10-20`, где `-20` второй токен.
# todo: 10- todo там 0 в конце че за бред?
10-
20

# 10--20
10-
-20

# Тут минус не втягивается т.к. не может без парсера - он бинарный
10-
b

# Должно быть слито
a. b() + c

# Должно быть слито
a.
  b() +
  c

