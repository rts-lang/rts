
##
  Проверяет, что комментарий не занимает номер элемента: `a.N` не зависит от комментариев.
  Токенайзер удаляет комментарии; только analyzer оставляет их как часть кода.
##

a {
  10
  # comment

  20
  ##
    multi
    line
  ##
  30 # trailing
}
print(f"{a.0} {a.1} {a.2}\n")  # 10 20 30

b {
  10
  # comment
  print(20)
}
print(f"{b.0} {b.1}\n")  # 10 print
